{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard | News Tracker{% endblock %}

{% block body %}
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h1 class="h3 m-0">Admin Dashboard</h1>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            {# Manueller Import-Trigger #}
            <form action="{{ path('admin_run_import') }}" method="POST" class="d-inline">
                <button type="submit" class="btn btn-primary shadow-sm">
                    <i class="fas fa-sync-alt me-2"></i>Jetzt Import starten
                </button>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <!-- Statistik Karte -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Gespeicherte News</h6>
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3">
                            <i class="fas fa-database fa-2x"></i>
                        </div>
                        <h2 class="display-6 fw-bold mb-0">{{ total_news }}</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cronjob Einstellungen -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-3 fw-bold">
                    <i class="fas fa-clock me-2 text-secondary"></i>Automatisierung
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <div class="form-check form-switch me-4">
                            <input disabled class="form-check-input" type="checkbox" id="cronStatus" {{ cron_active ? 'checked' : '' }}>
                            <label class="form-check-label fw-bold" for="cronStatus">Täglicher Import aktiv</label>
                        </div>
                    </div>

                    <div class="row align-items-end g-2">
                        <div class="col-sm-4">
                            <label class="small text-muted mb-1">Import Uhrzeit</label>
                            <input disabled type="time" class="form-control" value="08:00">
                        </div>
                        <div class="col-sm-4">
                            <button disabled class="btn btn-outline-secondary w-100" type="button">Speichern</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12 text-center text-muted">
            <p class="small">Verbindungsstatus zur ARD API: <span class="badge bg-success">Online</span></p>
        </div>
    </div>
{% endblock %}
