services:
###> doctrine/doctrine-bundle ###
  database:
    ports:
      - "5432:5432" # Expose PostgreSQL port to the host
###< doctrine/doctrine-bundle ###

  php:
    build:
      context: .
      args:
        - INSTALL_XDEBUG=true # Toggle Xdebug installation during build
    extra_hosts:
      - "host.docker.internal:host-gateway" # Required for Xdebug to connect to your IDE on Linux
